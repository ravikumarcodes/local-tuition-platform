// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  TEACHER
  PARENT
  STUDENT
  ADMIN
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

model User {
  id           String     @id @default(uuid())
  name         String
  email        String?    @unique
  phone        String?    @unique
  passwordHash String
  role         UserRole   @default(STUDENT)
  status       UserStatus @default(ACTIVE)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  teacherProfile TeacherProfile?
  studentProfile StudentProfile?
  ParentProfile  ParentProfile?
}

model TeacherProfile {
  id                     String   @id @default(uuid())
  userId                 String   @unique
  qualification          String?
  experienceYears        Int?
  bio                    String?
  locality               String?
  city                   String?
  teachingMode           String?
  profileImageUrl        String?
  identityVerified       Boolean  @default(false)
  qualificationVerified Boolean  @default(false)
  experienceVerified    Boolean  @default(false)
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt
  batches Batch[]
  enrollments Enrollment[]
  homework Homework[]
  tests Test[]
  students StudentProfile[]

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model StudentProfile {
  id          String        @id @default(uuid())
  userId      String?       @unique
  teacherId   String?
  name        String
  dateOfBirth DateTime?
  gender      String?
  schoolName  String?
  className   String?
  board       String?
  phone       String?
  status      StudentStatus @default(ACTIVE)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  parents ParentStudent[]
  enrollments Enrollment[]
  feeRecords FeeRecord[]
  feeTransactions FeeTransaction[]
  attendance Attendance[]
  homeworkSubmissions HomeworkSubmission[]
  testResults TestResult[]

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)
  teacher TeacherProfile? @relation(fields: [teacherId], references: [id], onDelete: Cascade)
}

enum StudentStatus {
  ACTIVE
  INACTIVE
  LEFT
}

model ParentProfile {
  id        String   @id @default(uuid())
  userId    String   @unique
  address   String?
  locality  String?
  city      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  children ParentStudent[]
}

model ParentStudent {
  id        String   @id @default(uuid())
  parentId  String
  studentId String
  isPrimary Boolean  @default(false)
  createdAt DateTime @default(now())

  parent  ParentProfile  @relation(fields: [parentId], references: [id], onDelete: Cascade)
  student StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([parentId, studentId])
}

model Subject {
  id        String   @id @default(uuid())
  name      String   @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  batches Batch[]
}

model Batch {
  id          String   @id @default(uuid())
  teacherId   String
  subjectId   String
  name        String
  className   String?
  startTime   String
  endTime     String
  days        String
  maxStudents Int?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  enrollments Enrollment[]
  attendance Attendance[]
  homework Homework[]
  tests Test[]

  teacher TeacherProfile @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  subject Subject        @relation(fields: [subjectId], references: [id])
}

enum EnrollmentStatus {
  ACTIVE
  COMPLETED
  CANCELLED
}

model Enrollment {
  id          String           @id @default(uuid())
  teacherId   String
  studentId   String
  batchId     String
  joinedAt    DateTime
  leftAt      DateTime?
  monthlyFee  Decimal          @db.Decimal(10, 2)
  status      EnrollmentStatus @default(ACTIVE)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  feeRecords FeeRecord[]

  teacher TeacherProfile @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  student StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
  batch   Batch          @relation(fields: [batchId], references: [id], onDelete: Cascade)
}

enum FeeStatus {
  PENDING
  PARTIAL
  PAID
  WAIVED
  ADJUSTED
}

model FeeRecord {
  id              String     @id @default(uuid())
  enrollmentId    String
  studentId       String
  month           Int
  year            Int
  monthlyFee      Decimal    @db.Decimal(10, 2)
  totalTuitionDays Int
  applicableDays  Int
  calculatedAmount Decimal   @db.Decimal(10, 2)
  adjustmentAmount Decimal   @default(0) @db.Decimal(10, 2)
  adjustmentReason String?
  approvedAmount  Decimal    @db.Decimal(10, 2)
  paidAmount      Decimal    @default(0) @db.Decimal(10, 2)
  status          FeeStatus  @default(PENDING)
  dueDate         DateTime?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
  transactions FeeTransaction[]

  enrollment Enrollment      @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  student    StudentProfile  @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([enrollmentId, month, year])
}

enum PaymentMethod {
  CASH
  UPI
  BANK_TRANSFER
  CARD
  OTHER
}

model FeeTransaction {
  id            String        @id @default(uuid())
  feeRecordId   String
  studentId     String
  amount        Decimal       @db.Decimal(10, 2)
  paymentDate   DateTime      @default(now())
  paymentMethod PaymentMethod
  referenceNo   String?
  note          String?
  createdAt     DateTime      @default(now())

  feeRecord FeeRecord     @relation(fields: [feeRecordId], references: [id], onDelete: Cascade)
  student   StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LEAVE
}

model Attendance {
  id        String           @id @default(uuid())
  studentId String
  batchId   String
  date      DateTime
  status    AttendanceStatus
  note      String?
  createdAt DateTime         @default(now())

  student StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
  batch   Batch          @relation(fields: [batchId], references: [id], onDelete: Cascade)

  @@unique([studentId, batchId, date])
}

enum HomeworkStatus {
  ACTIVE
  CLOSED
}

model Homework {
  id           String         @id @default(uuid())
  teacherId    String
  batchId      String
  title        String
  description  String?
  attachmentUrl String?
  assignedDate DateTime
  dueDate      DateTime?
  status       HomeworkStatus @default(ACTIVE)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  submissions HomeworkSubmission[]

  teacher TeacherProfile @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  batch   Batch          @relation(fields: [batchId], references: [id], onDelete: Cascade)
}

model HomeworkSubmission {
  id           String   @id @default(uuid())
  homeworkId   String
  studentId    String
  submittedAt  DateTime?
  attachmentUrl String?
  note         String?
  createdAt    DateTime @default(now())

  homework Homework       @relation(fields: [homeworkId], references: [id], onDelete: Cascade)
  student  StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([homeworkId, studentId])
}

model Test {
  id         String   @id @default(uuid())
  teacherId  String
  batchId    String
  title      String
  maxMarks   Int
  testDate   DateTime
  createdAt  DateTime @default(now())
  results TestResult[]

  teacher TeacherProfile @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  batch   Batch          @relation(fields: [batchId], references: [id], onDelete: Cascade)
}

model TestResult {
  id        String   @id @default(uuid())
  testId    String
  studentId String
  marks     Decimal  @db.Decimal(10, 2)
  remarks   String?
  createdAt DateTime @default(now())

  test    Test           @relation(fields: [testId], references: [id], onDelete: Cascade)
  student StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([testId, studentId])
}